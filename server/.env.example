# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster credentials:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skillproof?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT Secret Key for token signing and verification
JWT_SECRET=your_super_secret_jwt_key_here

# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: GitHub Personal Access Token to avoid GitHub API rate limiting
GITHUB_TOKEN=
